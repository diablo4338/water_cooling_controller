# syntax=docker/dockerfile:1.7

ARG UBUNTU_VERSION=20.04
FROM ubuntu:${UBUNTU_VERSION}

ARG PYTHON_VERSION=3.12.13
ARG OPENSSL_VERSION=3.2.3
ARG ESP_IDF_VERSION=v5.4.4
ARG ESP_IDF_TARGETS=esp32c3

ENV DEBIAN_FRONTEND=noninteractive
ENV TZ=Etc/UTC
ENV LANG=C.UTF-8
ENV LC_ALL=C.UTF-8

SHELL ["/bin/bash", "-o", "pipefail", "-c"]

RUN apt-get update && \
    apt-get install -y --no-install-recommends \
        ca-certificates \
        wget \
        curl \
        git \
        xz-utils \
        zip \
        unzip \
        file \
        bash \
        make \
        build-essential \
        pkg-config \
        cmake \
        ninja-build \
        ccache \
        flex \
        bison \
        gperf \
        patchelf \
        dfu-util \
        libusb-1.0-0 \
        libfuse2 \
        libffi-dev \
        libssl-dev \
        libbz2-dev \
        libreadline-dev \
        libsqlite3-dev \
        libncursesw5-dev \
        libgdbm-dev \
        liblzma-dev \
        libexpat1-dev \
        tk-dev \
        uuid-dev \
        zlib1g-dev \
        libglib2.0-0 \
        libdbus-1-3 \
        libgl1 \
        libegl1 \
        libxcb1 \
        libx11-6 \
        libxext6 \
        libxrender1 \
        libxkbcommon-x11-0 \
        libfontconfig1 \
        libfreetype6 \
        libxcb-cursor0 \
        libxcb-icccm4 \
        libxcb-image0 \
        libxcb-keysyms1 \
        libxcb-randr0 \
        libxcb-render-util0 \
        libxcb-shape0 \
        libxcb-xinerama0 \
        libxcb-xfixes0 \
        zlib1g && \
    update-ca-certificates && \
    rm -rf /var/lib/apt/lists/*

RUN cd /tmp && \
    wget -O "openssl-${OPENSSL_VERSION}.tar.gz" \
        "https://www.openssl.org/source/openssl-${OPENSSL_VERSION}.tar.gz" && \
    tar -xzf "openssl-${OPENSSL_VERSION}.tar.gz" && \
    cd "openssl-${OPENSSL_VERSION}" && \
    ./Configure linux-x86_64 \
        --prefix="/opt/openssl-${OPENSSL_VERSION}" \
        --openssldir="/opt/openssl-${OPENSSL_VERSION}/ssl" \
        shared \
        zlib && \
    make -j"$(nproc)" && \
    make install_sw && \
    test -f "/opt/openssl-${OPENSSL_VERSION}/lib64/libssl.so.3" && \
    test -f "/opt/openssl-${OPENSSL_VERSION}/lib64/libcrypto.so.3" && \
    test -d "/opt/openssl-${OPENSSL_VERSION}/include/openssl" && \
    echo "/opt/openssl-${OPENSSL_VERSION}/lib64" > "/etc/ld.so.conf.d/openssl-${OPENSSL_VERSION}.conf" && \
    ln -sf "/opt/openssl-${OPENSSL_VERSION}/bin/openssl" /usr/local/bin/openssl && \
    mkdir -p "/opt/openssl-${OPENSSL_VERSION}/ssl" && \
    ln -sf /etc/ssl/certs/ca-certificates.crt "/opt/openssl-${OPENSSL_VERSION}/ssl/cert.pem" && \
    rm -rf "/opt/openssl-${OPENSSL_VERSION}/ssl/certs" && \
    ln -s /etc/ssl/certs "/opt/openssl-${OPENSSL_VERSION}/ssl/certs" && \
    ldconfig && \
    openssl version -a && \
    rm -rf "/tmp/openssl-${OPENSSL_VERSION}" "/tmp/openssl-${OPENSSL_VERSION}.tar.gz"

ENV SSL_CERT_FILE=/etc/ssl/certs/ca-certificates.crt
ENV REQUESTS_CA_BUNDLE=/etc/ssl/certs/ca-certificates.crt
ENV CURL_CA_BUNDLE=/etc/ssl/certs/ca-certificates.crt

RUN cd /tmp && \
    wget -O "Python-${PYTHON_VERSION}.tgz" \
        "https://www.python.org/ftp/python/${PYTHON_VERSION}/Python-${PYTHON_VERSION}.tgz" && \
    tar -xzf "Python-${PYTHON_VERSION}.tgz" && \
    cd "Python-${PYTHON_VERSION}" && \
    PKG_CONFIG_PATH="/opt/openssl-${OPENSSL_VERSION}/lib64/pkgconfig" \
    CPPFLAGS="-I/opt/openssl-${OPENSSL_VERSION}/include" \
    LDFLAGS="-L/opt/openssl-${OPENSSL_VERSION}/lib64 -Wl,-rpath,/opt/openssl-${OPENSSL_VERSION}/lib64" \
    LD_LIBRARY_PATH="/opt/openssl-${OPENSSL_VERSION}/lib64" \
    ./configure \
        --prefix="/opt/python-${PYTHON_VERSION}" \
        --enable-shared \
        --with-ensurepip=install \
        --with-openssl="/opt/openssl-${OPENSSL_VERSION}" \
        --with-openssl-rpath=auto && \
    PKG_CONFIG_PATH="/opt/openssl-${OPENSSL_VERSION}/lib64/pkgconfig" \
    CPPFLAGS="-I/opt/openssl-${OPENSSL_VERSION}/include" \
    LDFLAGS="-L/opt/openssl-${OPENSSL_VERSION}/lib64 -Wl,-rpath,/opt/openssl-${OPENSSL_VERSION}/lib64" \
    LD_LIBRARY_PATH="/opt/openssl-${OPENSSL_VERSION}/lib64" \
    make -j"$(nproc)" && \
    LD_LIBRARY_PATH="/opt/openssl-${OPENSSL_VERSION}/lib64" \
    make altinstall && \
    echo "/opt/python-${PYTHON_VERSION}/lib" > "/etc/ld.so.conf.d/python-${PYTHON_VERSION}.conf" && \
    ln -sf "/opt/python-${PYTHON_VERSION}/bin/python3.12" /usr/local/bin/python3.12 && \
    ln -sf "/opt/python-${PYTHON_VERSION}/bin/pip3.12" /usr/local/bin/pip3.12 && \
    ln -sf "/opt/python-${PYTHON_VERSION}/bin/python3.12" /usr/local/bin/python && \
    ln -sf "/opt/python-${PYTHON_VERSION}/bin/pip3.12" /usr/local/bin/pip && \
    ldconfig && \
    python3.12 --version && \
    python3.12 -c "import ssl; print(ssl.OPENSSL_VERSION); print(ssl.get_default_verify_paths())" && \
    python3.12 -m pip install --no-cache-dir --upgrade pip wheel setuptools && \
    rm -rf "/tmp/Python-${PYTHON_VERSION}" "/tmp/Python-${PYTHON_VERSION}.tgz"

RUN python3.12 - <<'PY_EOF'
import ssl
import urllib.request

print("OpenSSL:", ssl.OPENSSL_VERSION)
print("Default verify paths:", ssl.get_default_verify_paths())
with urllib.request.urlopen("https://github.com", timeout=30) as response:
    print("HTTPS check:", response.status)
PY_EOF

ENV IDF_PATH=/opt/esp/idf
ENV IDF_TOOLS_PATH=/opt/esp/tools
ENV IDF_CCACHE_ENABLE=1
ENV CCACHE_DIR=/work/.ccache
ENV PYTHON_BIN=python3.12
ENV PYTHON=python3.12

RUN rm -rf "${IDF_PATH}" "${IDF_TOOLS_PATH}" && \
    mkdir -p /opt/esp && \
    git clone \
        --branch "${ESP_IDF_VERSION}" \
        --recursive \
        --depth 1 \
        https://github.com/espressif/esp-idf.git \
        "${IDF_PATH}" && \
    cd "${IDF_PATH}" && \
    echo "Expected ESP-IDF: ${ESP_IDF_VERSION}" && \
    echo "Actual ESP-IDF:   $(git describe --tags --always)" && \
    test "$(git describe --tags --always)" = "${ESP_IDF_VERSION}" && \
    ./install.sh "${ESP_IDF_TARGETS}"

RUN bash -lc ". '${IDF_PATH}/export.sh' >/dev/null && idf.py --version && python --version && which idf.py && ls -la '${IDF_TOOLS_PATH}/python_env'"

ENV OPENSSL_VERSION=${OPENSSL_VERSION}
ENV PYTHON_VERSION=${PYTHON_VERSION}
ENV ESP_IDF_VERSION=${ESP_IDF_VERSION}

ENV OPENSSL_ROOT_DIR=/opt/openssl-${OPENSSL_VERSION}
ENV OPENSSL_DIR=/opt/openssl-${OPENSSL_VERSION}
ENV LD_LIBRARY_PATH=/opt/openssl-${OPENSSL_VERSION}/lib64:/opt/python-${PYTHON_VERSION}/lib
ENV PATH=/opt/openssl-${OPENSSL_VERSION}/bin:/opt/python-${PYTHON_VERSION}/bin:${PATH}

RUN cat > /usr/local/bin/pcwcc-entrypoint <<'ENTRYPOINT_EOF'
#!/usr/bin/env bash
set -e

if [ -f "${IDF_PATH}/export.sh" ]; then
    . "${IDF_PATH}/export.sh" >/dev/null
fi

exec "$@"
ENTRYPOINT_EOF

RUN chmod +x /usr/local/bin/pcwcc-entrypoint && \
    echo '. "${IDF_PATH}/export.sh" >/dev/null 2>&1 || true' >> /root/.bashrc

WORKDIR /work

RUN python --version && \
    openssl version && \
    bash -lc ". '${IDF_PATH}/export.sh' >/dev/null && idf.py --version"

ENTRYPOINT ["pcwcc-entrypoint"]
CMD ["/bin/bash"]
